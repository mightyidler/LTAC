{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LTAC",
  "version": "0.1.0",
  "identifier": "com.ltac.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LTAC",
        "width": 383,
        "height": 508,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "../target/release/ltac-service.exe": "ltac-service.exe",
      "../target/release/ltac.exe": "ltac-cli.exe",
      "../tools/Manage-Service.ps1": "Manage-Service.ps1"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/mightyidler/LTAC/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNjM2NkE0OEYzNzlERjMKUldUem5UZVBwR1pqN282Wm5icVhHd2YvSXF5aHV5Tm5mVythc2x1OG9YcnB6M0VGbm81TWtkSDEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
